# Copy to .env (repo root) and fill in. Never commit .env.
# The backend reads this file in development; Docker Compose passes it to the backend container.

# ---- Application ----
# development | test | production
APP_ENV=development
APP_NAME=KayGPT
DEBUG=false
LOG_LEVEL=INFO
# JSON logs (set false for readable local logs)
LOG_JSON=true

# ---- Database (PostgreSQL only) ----
# postgres:// and postgresql:// URLs are accepted and switched to the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kaygpt
# Backend test suite only (database is dropped and recreated):
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/kaygpt_test

# ---- LLM ----
# gemini | fake (fake = offline tests/e2e; refused in production)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
# default model; must be in GEMINI_MODELS
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.1-pro-preview,gemini-3.5-flash-lite
LLM_TEMPERATURE=0.3
EMBEDDING_MODEL=gemini-embedding-001

# ---- Web search ----
# required in production; without it web search reports "not configured"
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# ---- LangSmith tracing (optional; read directly by LangChain) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=KayGPT

# ---- URLs / CORS ----
# allowed browser origin (CORS + CSRF origin check)
FRONTEND_URL=http://localhost:3000
# public URL of the API itself
BACKEND_URL=http://localhost:8000
# optional comma-separated list; defaults to FRONTEND_URL
CORS_ORIGINS=

# ---- Auth / sessions ----
# 32+ random chars, required in production: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_TTL_DAYS=30
# default: true in production
COOKIE_SECURE=
# lax (same-origin proxy, default) | none (direct cross-origin mode)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ---- Rate limits (per IP per minute, per process) ----
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# ---- Vector store (ChromaDB) ----
# persistent (local dir) | http (Chroma server) | ephemeral (tests)
CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false

# ---- File storage ----
# local | s3 (any S3-compatible service)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
S3_BUCKET=
# e.g. https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=kaygpt/

# ---- Streaming ----
SSE_HEARTBEAT_SECONDS=15

# ---- Frontend (frontend/.env.local or Vercel project settings) ----
# BACKEND_URL above is also used by `next build` to proxy /api/v1/* to FastAPI.
# leave empty (recommended same-origin proxy); set only for direct cross-origin mode
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_MAX_UPLOAD_MB=20
